# Session State Initialisierung
if "display" not in st.session_state:
    st.session_state.display = "0"
if "last_ans" not in st.session_state:
    st.session_state.last_ans = "0"
if "reset_next" not in st.session_state:
    st.session_state.reset_next = False

# Funktionen für Tastenaktionen
def add_char(char):
    if st.session_state.reset_next:
        if char in ["+", "−", "×", "÷", "^", "%"]:
            st.session_state.reset_next = False
        else:
            st.session_state.display = ""
            st.session_state.reset_next = False
        
    if st.session_state.display == "0" and char not in [".", "+", "−", "×", "÷", "%", "^"]:
        st.session_state.display = char
    else:
        st.session_state.display += char

def clear_all():
    st.session_state.display = "0"
    st.session_state.reset_next = False

def delete_char():
    if st.session_state.reset_next:
        st.session_state.display = "0"
        st.session_state.reset_next = False
    elif len(st.session_state.display) > 1:
        st.session_state.display = st.session_state.display[:-1]
    else:
        st.session_state.display = "0"

def add_func(func_name):
    if st.session_state.reset_next:
        st.session_state.display = ""
        st.session_state.reset_next = False
    if st.session_state.display == "0":
        st.session_state.display = f"{func_name}("
    else:
        st.session_state.display += f"{func_name}("

def calculate():
    expr = st.session_state.display
    try:
        # Pre-process math string for python eval
        expr_clean = expr.replace("×", "*").replace("÷", "/").replace("−", "-").replace("^", "**")
        
        # Math context for scientific operations
        math_env = {
            "sin": lambda x: math.sin(math.radians(x)),
            "cos": lambda x: math.cos(math.radians(x)),
            "tan": lambda x: math.tan(math.radians(x)),
            "sqrt": math.sqrt,
            "log": math.log10,
            "ln": math.log,
            "pi": math.pi,
            "e": math.e,
            "Ans": float(st.session_state.last_ans) if st.session_state.last_ans != "Fehler" else 0
        }
        
        res = eval(expr_clean, {"__builtins__": None}, math_env)
        
        if isinstance(res, (int, float)):
            if abs(res) < 1e-12 and res != 0:
                res = 0
            if res == int(res):
                res_str = str(int(res))
            else:
                res_str = str(round(res, 8))
            st.session_state.display = res_str
            st.session_state.last_ans = res_str
        else:
            st.session_state.display = "Fehler"
    except Exception:
        st.session_state.display = "Fehler"
        
    st.session_state.reset_next = True

